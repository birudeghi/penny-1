# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
dist/
*.local

# Lockfiles are committed on purpose — CI installs with `uv sync --frozen` and `npm ci`,
# both of which fail without them. Never add these to the ignore rules above.
!backend/uv.lock
!frontend/package-lock.json

# Env / OS / editors
.env
.env.*
!.env.example
.DS_Store
.idea/
.vscode/

# Agent worktrees. Transient, and a `git add -A` would otherwise commit five checkouts.
.claude/worktrees/

# gstack's per-session scratch. `terminal-internal-token` is a live credential for the local
# agent process, and a `git add -A` mid-rebase is exactly how it got committed once already.
.gstack/
